# --- Abhängigkeiten & Build ---
node_modules/
dist/
build/
out/
.cache/
.vite/

# --- Geheimnisse & Umgebungsvariablen ---
# (wichtig, besonders mit Supabase-Keys)
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.env.json

# --- Test- & Coverage-Artefakte ---
coverage/
test-results/
playwright-report/
.nyc_output/

# --- Logfiles & temporäre Dateien ---
*.log
*.swp
*.swo
*~

# --- Große / generierte Dateien ---
*.min.js
*.map
package-lock.json

# --- Binärdateien & Medien (nur für Cline ausblenden) ---
# Hinweis: kleine Icons/Assets in public/ bleiben im Repo, werden von Cline aber
# nicht angezeigt. Bei Bedarf einzelne Dateien mit !..dateiname.png freigeben.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.mp4
*.mov
*.pdf
*.woff
*.woff2

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- KI- & Deployment-Konfiguration ---
.netlify/

# --- Editor & System ---
.vscode/
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
