{
  "name": "parfum",
  "version": "1.0.0",
  "type": "module",
  "description": "Perfume collection management application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run test && npm run build && npm run e2e"
  },
  "keywords": [
    "perfume",
    "collection",
    "notes",
    "ai",
    "groq"
  ],
  "author": "Parfum Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-security": "^2.0.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "react-window": "^2.3.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@tabler/icons-react": "^3.49.0",
    "chart.js": "^4.4.3",
    "cheerio": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^20.1.2",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0"
  }
}
