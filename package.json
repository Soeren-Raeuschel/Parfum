{
  "name": "parfum",
  "version": "1.0.0",
  "type": "module",
  "description": "Perfume collection management application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write src/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "keywords": [
    "perfume",
    "collection",
    "notes",
    "ai",
    "groq"
  ],
  "author": "Parfum Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-security": "^2.0.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "react-window": "^2.3.3",
    "tailwindcss": "^3.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
